{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/bun.lock", "!.impeccable", "!data"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/client/src/prototype/**"],
      "linter": {
        "rules": {
          "a11y": "off",
          "complexity": {
            "noCommaOperator": "off",
            "noImportantStyles": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedFunctionParameters": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "useIterableCallbackReturn": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/client/src/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/http/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/runner", "**/runner/**"],
                    "message": "http must not import runner. They meet only through the DB and the EventBus."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/runner/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/http", "**/http/**"],
                    "message": "runner must not import http. They meet only through the DB and the EventBus."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/simc/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun:sqlite": "simc is a pure library: no DB code.",
                  "node:http": "simc is a pure library: no HTTP code.",
                  "node:https": "simc is a pure library: no HTTP code.",
                  "node:http2": "simc is a pure library: no HTTP code."
                },
                "patterns": [
                  {
                    "group": ["@simbot/server", "@simbot/server/**", "**/apps/server/**"],
                    "message": "simc must not import server code."
                  },
                  {
                    "group": ["**/db", "**/db/**", "**/http", "**/http/**"],
                    "message": "simc is a pure library: no DB or HTTP code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!zod", "!zod/**", "!./**", "!../**"],
                    "message": "shared imports only zod."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
